# Customer 360 backend — production environment template.
# Copy to the host as /etc/hf/c360.env (NOT committed) and inject with:
#     docker run ... --env-file /etc/hf/c360.env ...
# Mirrors the portfolio's /etc/hf/prod.env convention.

# --- Django core ------------------------------------------------------------
# C360's OWN secret (sessions, MFA ticket, password-reset codes). Generate a fresh
# one; it is NOT shared with the portfolio. `python -c "import secrets;print(secrets.token_urlsafe(64))"`
DJANGO_SECRET_KEY=change-me-unique-per-environment
DJANGO_DEBUG=false
# Hostnames the API is served on (public domain + LAN IP). Comma-separated.
DJANGO_ALLOWED_HOSTS=ceo.hfcb.co.ke,128.2.1.25,localhost,127.0.0.1
# Gunicorn host port (see Dockerfile; must not collide with the portfolio's 9000).
PORT=9001

# --- Single sign-on with the portfolio (backlog #12) ------------------------
# THE key line: set this to the PORTFOLIO backend's SECRET_KEY so a token minted by
# the portfolio validates here. Deliberately separate from DJANGO_SECRET_KEY above.
C360_JWT_SIGNING_KEY=paste-the-portfolio-backend-SECRET_KEY-here
# Require a valid token on every data endpoint (only auth/meta stay open).
C360_REQUIRE_AUTH=true
# Two-step login (password -> emailed OTP) for C360's own local accounts.
C360_LOGIN_MFA=true
# Cookies (admin / browsable API) TLS-only in production.
C360_COOKIE_SECURE=true

# --- Staff-customer confidentiality (admin-only) ----------------------------
# Customers who are HF employees must be invisible to RMs and to management —
# only the admin tier (ceo / exco / hfdi_admin / superuser) may search or open them.
# A record is treated as staff if ANY signal below fires (fail-safe). Tune to match
# the warehouse after running the verification query in DEPLOY.md; leave unset to use
# the built-in defaults. Comma-separated, case-insensitive.
#   employer text meaning "works for HF" (substring match):
# C360_STAFF_EMPLOYER_PATTERNS=HOUSING FINANCE,HF GROUP,HFC LTD,HFCB,HF BANK,HFDI
#   customer_segment / scheme values that denote a staff scheme (exact match):
# C360_STAFF_SEGMENTS=STAFF,STAFF SCHEME,EMPLOYEE
#   fk_bankemployeeid values that are NOT a real staff link (placeholders):
# C360_STAFF_EMPID_PLACEHOLDERS=MIG_CIS,0,NULL,NONE

# --- CORS / CSRF — the SPA origins (public + LAN) ---------------------------
# Full scheme+host. Set to wherever the Customer 360 frontend is served from.
C360_CORS_ORIGINS=https://ceo.hfcb.co.ke,http://128.2.1.25:5401
C360_CSRF_TRUSTED_ORIGINS=https://ceo.hfcb.co.ke,http://128.2.1.25:5401

# --- Data mode + warehouse (delta.gold_db over Trino) -----------------------
C360_DATA_MODE=live
TRINO_HOST=
TRINO_PORT=443
TRINO_USER=
TRINO_PASSWORD=
TRINO_HTTP_SCHEME=https
TRINO_CATALOG=delta
TRINO_SCHEMA=gold_db
TRINO_VERIFY_SSL=false

# Curated Postgres (retail_allocated_portfolio → the CURRENT customer→RM allocation).
# Core banking / Trino only carries the frozen account-opening officer, so without this
# the header shows an RM who may no longer manage the customer. Set these to the
# reporting Postgres (reachable from the app server) to source the live current RM;
# leave blank to keep the account-opening-officer fallback. Only imported in live mode.
PG_HOST=
PG_PORT=5432
PG_DBNAME=
PG_USER=
PG_PASSWORD=
# Optional: the gateway auto-detects the allocation table + columns from the DB schema.
# Set these ONLY if the auto-detection picks the wrong ones (values are table/column
# names in the reporting Postgres). PG_ALLOC_TABLE may be schema-qualified.
# PG_ALLOC_TABLE=public.retail_allocated_portfolio
# PG_ALLOC_CUST_COL=customer_id
# PG_ALLOC_NAME_COL=rm_name
# PG_ALLOC_CODE_COL=sales_code
# PG_ALLOC_DATE_COL=allocated_date

# --- App DB (C360's own users/OTP/feedback/JWT-blacklist tables) ------------
# RECOMMENDED: a dedicated database on the SAME Postgres server the portfolio uses,
# so nothing is lost when the container is replaced. Uncomment to use Postgres:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=customer360_app
# DB_USER=customer360_app
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=5432
#
# SIMPLE ALTERNATIVE: keep SQLite but point it at a bind-mounted path so it persists
# across `docker rm` (mount -v /data/apps/customer360/appdb:/app/appdb):
# DB_NAME=/app/appdb/db.sqlite3

# --- Email (OTP / password-reset delivery) ----------------------------------
C360_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=HFCB Customer 360 <no-reply@hfcb.co.ke>

# --- Token lifetimes (optional; defaults 30 min / 7 days) -------------------
# ACCESS_TOKEN_LIFETIME_MINUTES=30
# REFRESH_TOKEN_LIFETIME_DAYS=7
